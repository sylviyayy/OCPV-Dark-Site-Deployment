ENV_SCHEMA_VERSION=2
# =============================================================================
# OCPV-Dark-Site-Deployment — site field register (schema v2)
#
#   cp .env.example .env && vim .env
#
# Values: POC Cluster Sizing & IP Address Assignment sheet (cluster ocpv-poc.example.com).
#
# WHERE TO CHANGE AN IP: here, and only here. Copy this file to .env and edit .env; every
# script, kickstart, dnsmasq/chrony config and manifest is rendered from it. Values not in the
# sheet are PLACEHOLDERS, each marked ">>> UPDATE" with what to put there:
#
#   grep -n 'UPDATE' .env
#
# Keys keep the order and IDs (A1 ... G4) of the field register in docs/labs/03-checklist.md.
# Every script validates .env first. The bastion steps (DNS/NTP, kickstart) check only the
# keys they use (--scope services|kickstart), so they run on day 1; the install steps refuse
# to start until every key is real (node MACs, root devices, exact version, pull secret).
#
# The Agent ISO freezes node identity (MAC -> IP -> hostname -> role), the VIPs and
# the registry mirrors into its Ignition. Change a value after Lab 08 and you rebuild
# the ISO; change CLUSTER_NAME or BASE_DOMAIN after install and you reinstall.
# No passwords live here: scripts prompt for them (FR-K2).
# =============================================================================

# --- A. Cluster identity -----------------------------------------------------
# A1  OpenShift lead  · lowercase RFC 1123 label
CLUSTER_NAME=ocpv-poc
# A2  DNS owner       · not .local (mDNS, RFC 6762). Cannot change after install.
BASE_DOMAIN=example.com
# A3  OpenShift lead  · exact z-stream present in stable-4.22 at mirror time
OCP_VERSION=4.22.z            # >>> UPDATE: exact z-stream you mirror, e.g. 4.22.3 (sheet: 4.x.x); needed from Lab 06
# A4  OpenShift lead  · minor equals OCP_VERSION minor
OCP_CHANNEL=stable-4.22

# --- B. Machine network ------------------------------------------------------
# B1  Network · contains every node, VIP, bastion, registry and VM IP
MACHINE_NETWORK_CIDR=10.10.10.0/24     # Management VLAN 101
# B2  Network · inside B1
NETWORK_GATEWAY=10.10.10.1
# B3  Network · no overlap with B1, routed site ranges, or OVN-K 100.64.0.0/16, 100.88.0.0/16
CLUSTER_NETWORK_CIDR=10.128.0.0/14     # pods; /23 per node (hostPrefix 23)
SERVICE_NETWORK_CIDR=172.30.0.0/16
# B4  Network · equals the switch MTU end to end
MTU=1500                      # >>> UPDATE if the switches use jumbo frames
# B5  Network · inside B1, unused, not pingable before install
API_VIP=10.10.10.140          # api / api-int.ocpv-poc.example.com
# B6  Network · same rules as B5; differs from B5
INGRESS_VIP=10.10.10.141      # >>> UPDATE: placeholder (sheet leaves *.apps blank); an unused IP in 10.10.10.0/24

# --- C. Control-plane nodes (compact: three schedulable control-plane nodes) --
# C1  Hardware · short names, not FQDNs
MW01_HOSTNAME=mw01
MW02_HOSTNAME=mw02
MW03_HOSTNAME=mw03
# C2  Network  · unique; inside B1
MW01_IP=10.10.10.137
MW02_IP=10.10.10.138          # >>> UPDATE: placeholder (sheet repeats .137 for all three nodes)
MW03_IP=10.10.10.139          # >>> UPDATE: placeholder (sheet repeats .137 for all three nodes)
# C3  Hardware · exactly the 4 bond0 members as <ifname>=<MAC>, names as RHCOS enumerates them
MW01_NICS="ens1f0=00:00:00:00:00:00,ens1f1=00:00:00:00:00:00,ens2f0=00:00:00:00:00:00,ens2f1=00:00:00:00:00:00"
MW02_NICS="ens1f0=00:00:00:00:00:00,ens1f1=00:00:00:00:00:00,ens2f0=00:00:00:00:00:00,ens2f1=00:00:00:00:00:00"
MW03_NICS="ens1f0=00:00:00:00:00:00,ens1f1=00:00:00:00:00:00,ens2f0=00:00:00:00:00:00,ens2f1=00:00:00:00:00:00"
# C4  Hardware · stable path to the RAID1 virtual disk; never /dev/sdX
MW01_ROOT_DEVICE=/dev/disk/by-path/pci-0000:…
MW02_ROOT_DEVICE=/dev/disk/by-path/pci-0000:…
MW03_ROOT_DEVICE=/dev/disk/by-path/pci-0000:…
# C5  Hardware · XCC address, reachable from the admin workstation
MW01_BMC_IP=10.10.20.11       # >>> UPDATE: placeholder; XCC address from the hardware team
MW02_BMC_IP=10.10.20.12       # >>> UPDATE: placeholder
MW03_BMC_IP=10.10.20.13       # >>> UPDATE: placeholder
# C6  OpenShift lead · equals one of C2
RENDEZVOUS_IP=${MW01_IP}

# --- D. Bastion and mirror registry -------------------------------------------
# D1  Infrastructure · short name; IP inside B1
BASTION_HOSTNAME=bastion
BASTION_IP=10.10.10.135       # >>> UPDATE: placeholder; must be the address on the bastion's NIC in 10.10.10.0/24
# D2  Infrastructure · from `ip -br link` on the bastion
BASTION_IFNAME=eno1           # >>> UPDATE: from `ip -br link` on the bastion (used by the kickstart only)
# D3  Infrastructure · FQDN under BASE_DOMAIN; resolves via bastion DNS
MIRROR_REGISTRY_HOSTNAME=registry.${BASE_DOMAIN}
# D4  Infrastructure · 8443 (mirror-registry default) unless site policy mandates 443
MIRROR_REGISTRY_PORT=8443
# D5  Infrastructure · DNS A record only; may equal BASTION_IP only if the bastion is never retired
MIRROR_REGISTRY_IP=10.10.10.136  # >>> UPDATE: placeholder; registry host, or = BASTION_IP if co-located (then never retire the bastion)
# D6  Infrastructure · registry admin user (its password is prompted, never stored here)
MIRROR_REGISTRY_USER=init

# --- E. Site services ---------------------------------------------------------
# E1  Site / security · IP of a reference clock, or "orphan" (marks the run lab-grade)
#     Sheet NTP server. If the bastion cannot reach it, chronyd serves its own clock until it can.
TIME_SOURCE=10.50.11.12
# E2  Network · two unused IPs, one per DNS VM
DNS_VM_IPS=10.10.10.145,10.10.10.146   # >>> UPDATE: placeholders; two unused IPs for the DNS VMs (Lab 14)
# E3  Network · unused
NTP_VM_IP=10.10.10.147        # >>> UPDATE: placeholder; unused IP for the NTP VM (Lab 14)
# E4  OpenShift lead · localnet or linux-bridge (ADR-06)
VM_NETWORK_MODEL=localnet
# E5  OpenShift lead · hpp (interim, node-local), ontap (Lenovo DM/DG array) or lvms (DS array LUNs) — ADR-05
STORAGE_BACKEND=hpp

# --- F. Files and directories -------------------------------------------------
# F1  OpenShift lead · valid JSON with "auths"; outside the repo
PULL_SECRET_FILE=/opt/ocp-mirror/pull-secret.json
# F2  OpenShift lead · file exists (ssh-keygen -t ed25519)
SSH_PUBLIC_KEY_FILE=${HOME}/.ssh/id_ed25519.pub
# F3  Infrastructure · owned by the installer user; free space >= 2x archive size
MIRROR_DIR=/opt/ocp-mirror
# F4  OpenShift lead · openshift-install --dir; outside the git working tree (ADR-08)
INSTALL_DIR=${HOME}/ocp-install/${CLUSTER_NAME}

# --- G. Storage array — only used when STORAGE_BACKEND=ontap ------------------
# Lenovo ThinkSystem DM / DG series (NetApp ONTAP). Values from the storage team's SVM setup.
# G1  Storage · SVM management LIF; reachable from every node
ONTAP_MGMT_IP=10.10.10.160    # >>> UPDATE: placeholder; storage team
# G2  Storage · NFS data LIF; reachable from every node (machine network, or a routed storage VLAN)
ONTAP_DATA_IP=10.10.10.161    # >>> UPDATE: placeholder; storage team (sheet's Data VLAN 102 is 10.30.10.0/24)
# G3  Storage · SVM (storage virtual machine) that serves the VM volumes
ONTAP_SVM=svm_ocpv
# G4  Storage · SVM account with the vsadmin role (its password is prompted, never stored here)
ONTAP_USER=vsadmin

# =============================================================================
# Derived — DO NOT EDIT. validate-env.sh proves each still equals its formula.
# =============================================================================
MIRROR_REGISTRY=${MIRROR_REGISTRY_HOSTNAME}:${MIRROR_REGISTRY_PORT}
MIRROR_ARCHIVE_DIR=${MIRROR_DIR}/archive
IMAGESET_CONFIG=${MIRROR_DIR}/imageset-config.yaml
AUTH_FILE=${MIRROR_DIR}/auth.json
REGISTRY_CA_FILE=${MIRROR_DIR}/registry-ca.crt
CLUSTER_RESOURCES_DIR=${MIRROR_DIR}/archive/working-dir/cluster-resources
