# =============================================================================
# Site-specific variables — copy to .env and edit before running scripts
# =============================================================================

# --- Cluster identity ---
CLUSTER_NAME=ocpv-lab
BASE_DOMAIN=ocp-v.local

# OpenShift 4.22 — pin exact z-stream from console.redhat.com or mirror.openshift.com
OCP_VERSION=4.22.2
OCP_CHANNEL=stable-4.22

# --- Network (flat L2, no VLAN) ---
NETWORK_CIDR=10.10.0.0/16
NETWORK_GATEWAY=10.10.0.1
NETWORK_NETMASK=255.255.0.0
NETWORK_INTERFACE=ens192          # NIC on bare-metal nodes

# --- Static IPs ---
BASTION_IP=10.10.0.5
BASTION_HOSTNAME=bastion.${BASE_DOMAIN}
MIRROR_REGISTRY_IP=10.10.0.10
MIRROR_REGISTRY=${MIRROR_REGISTRY_IP}:443
MIRROR_REGISTRY_HOSTNAME=registry.${BASE_DOMAIN}
# mirror-registry for Red Hat OpenShift defaults to port 443 (not 5000)
MIRROR_REGISTRY_USER=init
MIRROR_REGISTRY_PASSWORD=changeme

# Bootstrap / API / Ingress VIPs (agent-based bare metal — no external LB required)
API_VIP=10.10.0.100
INGRESS_VIP=10.10.0.101

# Agent-based installer rendezvous IP (must match one control-plane node)
RENDEZVOUS_IP=10.10.1.11

# --- Control plane nodes (minimum 3) ---
CP01_IP=10.10.1.11
CP01_HOSTNAME=cp01.${BASE_DOMAIN}
CP01_MAC=00:50:56:00:00:11
CP02_IP=10.10.1.12
CP02_HOSTNAME=cp02.${BASE_DOMAIN}
CP02_MAC=00:50:56:00:00:12
CP03_IP=10.10.1.13
CP03_HOSTNAME=cp03.${BASE_DOMAIN}
CP03_MAC=00:50:56:00:00:13

# --- Worker nodes (minimum 2 for OCP-V) ---
WK01_IP=10.10.2.21
WK01_HOSTNAME=wk01.${BASE_DOMAIN}
WK01_MAC=00:50:56:00:00:21
WK02_IP=10.10.2.22
WK02_HOSTNAME=wk02.${BASE_DOMAIN}
WK02_MAC=00:50:56:00:00:22

# --- DNS (MVP bastion, then production VM) ---
DNS_SERVER=${BASTION_IP}
NTP_SERVER=${BASTION_IP}

# Production DNS/NTP VM IPs (post-install)
DNS_VM_IP=10.10.0.50
NTP_VM_IP=10.10.0.51

# --- Mirror paths (on staging machine) ---
MIRROR_DIR=/opt/ocp-mirror
PULL_SECRET_FILE=${MIRROR_DIR}/pull-secret.json
IMAGESET_CONFIG=${MIRROR_DIR}/imageset-config.yaml
OC_MIRROR_WORKDIR=${MIRROR_DIR}/oc-mirror-workdir

# Operator catalog (must match OCP minor version)
OPERATOR_CATALOG=registry.redhat.io/redhat/redhat-operator-index:v4.22

# --- SSH ---
SSH_USER=core
INSTALL_USER=installer

# --- OpenShift Virtualization (installed from mirrored catalog, stable channel) ---
# Verify CSV version after install: oc get csv -n openshift-cnv
CNV_PACKAGE=kubevirt-hyperconverged
CNV_CHANNEL=stable
