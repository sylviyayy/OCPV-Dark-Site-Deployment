#version=RHEL9
# Bastion — the permanent dark-site services host (ADR-02, ADR-07).
# Rendered by scripts/render-kickstart.sh from .env into ${INSTALL_DIR}/kickstart/ (FR-E4),
# then embedded into the RHEL 9 DVD with mkksiso (FR-E2). Never edit the rendered copy.
# Installs unattended from the DVD alone: every package below ships on BaseOS/AppStream.

cdrom
text
reboot
firstboot --disable

lang en_US.UTF-8
keyboard us
timezone UTC --utc

# Static address on the machine network. The resolver is the bastion's own dnsmasq,
# which Lab 07 binds to 127.0.0.1 and BASTION_IP (FR-E5).
network --bootproto=static --device=${BASTION_IFNAME} --ip=${BASTION_IP} --netmask=${MACHINE_NETWORK_NETMASK} --gateway=${NETWORK_GATEWAY} --nameserver=${BASTION_IP} --hostname=${BASTION_HOSTNAME}.${BASE_DOMAIN} --onboot=on --activate

# WARNING: wipes every disk the installer can see except the install medium.
# Explicit layout instead of autopart, which can cap / at ~70 GiB: / holds /opt/ocp-mirror
# (mirror archive + oc-mirror cache + DVD) and, when co-located, the registry's image storage.
zerombr
clearpart --all --initlabel
reqpart --add-boot
part pv.01 --size=1 --grow
volgroup vg_sys pv.01
logvol swap --vgname=vg_sys --name=swap --size=4096
logvol / --vgname=vg_sys --name=root --fstype=xfs --size=20480 --grow

# Declarative firewall: firewalld is not running inside %post, so firewall-cmd there fails.
firewall --enabled --ssh --service=dns,ntp

# UEFI: no --location=mbr; RHEL 9 kdump sizes its own reservation, so no crashkernel=auto (FR-E7).
bootloader

# No root login; the installer user's password hash was made at render time with
# `openssl passwd -6` from a prompted password, so no plaintext lives anywhere (FR-E3).
rootpw --lock
user --name=installer --groups=wheel --iscrypted --password=${KS_PASSWORD_HASH}
sshkey --username=installer "${SSH_PUBLIC_KEY}"

%packages
@^minimal-environment
bind-utils
chrony
curl
dnsmasq
firewalld
git
httpd
jq
nmstate
openssl
podman
python3-pyyaml
skopeo
tar
vim-enhanced
%end

# FR-E6: `mkksiso --add <repo>` puts the repository on the install medium. A chrooted
# %post cannot see the medium, so copy it from the installer environment here. The mount
# point differs between Anaconda releases, so both known locations are probed.
# TODO(verify-4.22): https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/automatically_installing_rhel/
%post --nochroot --log=/mnt/sysroot/root/ks-post-nochroot.log
for src in /run/install/repo/OCPV-Dark-Site-Deployment /run/install/sources/mount-0000-cdrom/OCPV-Dark-Site-Deployment; do
  if [ -d "$src" ]; then
    cp -a "$src" /mnt/sysroot/home/installer/
    break
  fi
done
%end

%post --log=/root/ks-post.log
set -eux

# The registry must resolve before Lab 07 starts dnsmasq: Lab 06 installs and loads it.
# dnsmasq also serves /etc/hosts, so these lines never disagree with DNS (both from .env).
cat >> /etc/hosts <<'HOSTS'
${BASTION_IP}  ${BASTION_HOSTNAME}.${BASE_DOMAIN} ${BASTION_HOSTNAME}
${MIRROR_REGISTRY_IP}  ${MIRROR_REGISTRY_HOSTNAME}
HOSTS

# chronyd runs from first boot; Lab 07 (scripts/02) writes its TIME_SOURCE-driven config.
systemctl enable chronyd
# dnsmasq stays off until Lab 07 writes its records.
systemctl disable dnsmasq

mkdir -p /opt/ocp-mirror
chown installer:installer /opt/ocp-mirror
if [ -d /home/installer/OCPV-Dark-Site-Deployment ]; then
  chown -R installer:installer /home/installer/OCPV-Dark-Site-Deployment
fi
%end
