ENV_SCHEMA_VERSION=2
# CI test values (FR-I5). A valid field register with no sample values, used to render
# every template. ${CI_TMP} is exported by tests/render-all.sh and holds the fixtures.

# --- A. Cluster identity ---
CLUSTER_NAME=ci01
BASE_DOMAIN=ci.internal
OCP_VERSION=4.22.3
OCP_CHANNEL=stable-4.22

# --- B. Machine network ---
MACHINE_NETWORK_CIDR=10.10.0.0/16
NETWORK_GATEWAY=10.10.0.1
CLUSTER_NETWORK_CIDR=10.128.0.0/14
SERVICE_NETWORK_CIDR=172.30.0.0/16
MTU=9000
API_VIP=10.10.0.100
INGRESS_VIP=10.10.0.101

# --- C. Control-plane nodes ---
CP01_HOSTNAME=cp01
CP02_HOSTNAME=cp02
CP03_HOSTNAME=cp03
CP01_IP=10.10.1.11
CP02_IP=10.10.1.12
CP03_IP=10.10.1.13
CP01_NICS="ens1f0=aa:bb:cc:00:01:01,ens1f1=aa:bb:cc:00:01:02,ens3f0=aa:bb:cc:00:01:03,ens3f1=aa:bb:cc:00:01:04"
CP02_NICS="ens1f0=aa:bb:cc:00:02:01,ens1f1=aa:bb:cc:00:02:02,ens3f0=aa:bb:cc:00:02:03,ens3f1=aa:bb:cc:00:02:04"
CP03_NICS="ens1f0=aa:bb:cc:00:03:01,ens1f1=aa:bb:cc:00:03:02,ens21f0=aa:bb:cc:00:03:03,ens21f1=aa:bb:cc:00:03:04"
CP01_ROOT_DEVICE=/dev/disk/by-path/pci-0000:41:00.0-scsi-0:2:0:0
CP02_ROOT_DEVICE=/dev/disk/by-path/pci-0000:41:00.0-scsi-0:2:0:0
CP03_ROOT_DEVICE=/dev/disk/by-path/pci-0000:c1:00.0-scsi-0:2:0:0
CP01_BMC_IP=10.20.0.11
CP02_BMC_IP=10.20.0.12
CP03_BMC_IP=10.20.0.13
RENDEZVOUS_IP=${CP01_IP}

# --- D. Bastion and mirror registry ---
BASTION_HOSTNAME=bastion
BASTION_IP=10.10.0.5
BASTION_IFNAME=eno1
MIRROR_REGISTRY_HOSTNAME=registry.${BASE_DOMAIN}
MIRROR_REGISTRY_PORT=8443
MIRROR_REGISTRY_IP=10.10.0.10
MIRROR_REGISTRY_USER=init

# --- E. Site services ---
TIME_SOURCE=10.10.0.2
DNS_VM_IPS=10.10.0.50,10.10.0.52
NTP_VM_IP=10.10.0.51
VM_NETWORK_MODEL=localnet
STORAGE_BACKEND=hpp

# --- F. Files and directories ---
PULL_SECRET_FILE=${CI_TMP}/pull-secret.json
SSH_PUBLIC_KEY_FILE=${CI_TMP}/id_ed25519.pub
MIRROR_DIR=${CI_TMP}/ocp-mirror
INSTALL_DIR=${CI_TMP}/install

# --- Derived ---
MIRROR_REGISTRY=${MIRROR_REGISTRY_HOSTNAME}:${MIRROR_REGISTRY_PORT}
MIRROR_ARCHIVE_DIR=${MIRROR_DIR}/archive
IMAGESET_CONFIG=${MIRROR_DIR}/imageset-config.yaml
AUTH_FILE=${MIRROR_DIR}/auth.json
REGISTRY_CA_FILE=${MIRROR_DIR}/registry-ca.crt
CLUSTER_RESOURCES_DIR=${MIRROR_DIR}/archive/working-dir/cluster-resources
