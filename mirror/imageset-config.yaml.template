# oc-mirror plugin v2 ImageSetConfiguration skeleton, loaded as data by
# scripts/lib/render.py imageset (FR-B6). Rendered to ${IMAGESET_CONFIG} by
# scripts/01-mirror-preparation.sh; that exact file crosses the air gap with the archive,
# because disk-to-mirror needs the ImageSet that produced it (FR-B7).
#
# Field                                      <- source
#   platform.channels[0].name                <- OCP_CHANNEL (A4)
#   platform.channels[0].min/maxVersion      <- OCP_VERSION (A3), one exact z-stream
#   operators[0].catalog                     <- redhat-operator-index:v<OCP minor>
#   operators[0].packages                    <- mirror/imageset-profiles.yaml (default [+ lvms] [+ coe])
#   additionalImages                         <- RHEL guest image pinned by digest; script 01
#                                               resolves the digest once (NFR-8, no :latest)
#
# No `graph: true`: the OpenShift Update Service is a v2.0 non-goal, and the
# updateService.yaml it adds to cluster-resources needs the OSUS operator to apply (Lab 12).
# Docs: https://docs.redhat.com/en/documentation/openshift_container_platform/4.22/html/disconnected_environments/about-installing-oc-mirror-v2
kind: ImageSetConfiguration
apiVersion: mirror.openshift.io/v2alpha1
mirror:
  platform:
    channels:
      - name: ""
        minVersion: ""
        maxVersion: ""
        type: ocp
  operators:
    - catalog: ""
      packages: []
  additionalImages: []
