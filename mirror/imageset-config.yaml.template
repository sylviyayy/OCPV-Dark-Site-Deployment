# oc-mirror plugin v2 ImageSetConfiguration
# Official format: mirror.openshift.io/v2alpha1
# Docs: https://docs.redhat.com/en/documentation/openshift_container_platform/4.22/html/disconnected_environments/about-installing-oc-mirror-v2
#
# Copy to ${MIRROR_DIR}/imageset-config.yaml and edit versions before mirroring.
# Generated by scripts/01-mirror-preparation.sh when .env is present.

kind: ImageSetConfiguration
apiVersion: mirror.openshift.io/v2alpha1
mirror:
  platform:
    channels:
      - name: stable-4.22
        minVersion: 4.22.2
        maxVersion: 4.22.2
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.22
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
  additionalImages:
    - name: registry.redhat.io/rhel9/rhel-guest-image:latest
