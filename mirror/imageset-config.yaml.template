# oc-mirror plugin v2 ImageSetConfiguration
# Official format: mirror.openshift.io/v2alpha1
# Docs: https://docs.redhat.com/en/documentation/openshift_container_platform/4.21/html/disconnected_environments/about-installing-oc-mirror-v2
#
# Copy to ${MIRROR_DIR}/imageset-config.yaml and edit versions before mirroring.
# Generated by scripts/01-mirror-preparation.sh when .env is present.

kind: ImageSetConfiguration
apiVersion: mirror.openshift.io/v2alpha1
mirror:
  platform:
    channels:
      - name: stable-4.21
        minVersion: 4.21.27
        maxVersion: 4.21.27
    graph: true
  operators:
    - catalog: registry.redhat.io/redhat/redhat-operator-index:v4.21
      packages:
        - name: kubevirt-hyperconverged
          channels:
            - name: stable
        # Host bridge for the permanent DNS/NTP VMs and the DNS cutover NNCP
        # (docs/BASTION-LIFECYCLE.md, Phases 6-7)
        - name: kubernetes-nmstate-operator
          channels:
            - name: stable
        # Storage: add exactly one storage operator BEFORE mirroring (vendor SAN CSI from
        # certified-operator-index, lvms-operator, or ODF). See docs/USB-TRANSFER-KIT.md §3.2.
  additionalImages:
    - name: registry.redhat.io/rhel9/rhel-guest-image:latest
