# agent-config.yaml skeleton, loaded as data by scripts/lib/render.py (FR-A1).
# The renderer builds hosts[] from .env because envsubst cannot emit a list: one entry
# per control-plane node, each with its four bond members (FR-D4).
#
# Field                                   <- source (field register ID)
#   metadata.name                         <- CLUSTER_NAME (A1, FR-D8)
#   rendezvousIP                          <- RENDEZVOUS_IP (C6)
#   additionalNTPSources[0]               <- TIME_SOURCE, or BASTION_IP when TIME_SOURCE=orphan (E1, FR-D6)
#   hosts[n].hostname                     <- MWn_HOSTNAME (C1)
#   hosts[n].rootDeviceHints.deviceName   <- MWn_ROOT_DEVICE (C4, FR-D5)
#   hosts[n].interfaces[]                 <- MWn_NICS (C3): the MACs that identify each server
#   hosts[n].networkConfig (nmstate)      <- bond0 802.3ad over MWn_NICS, MTU (B4), MWn_IP (C2),
#                                            NETWORK_GATEWAY (B2), resolver BASTION_IP (D1)
# TODO(verify-4.22): apiVersion v1beta1 per
#   https://docs.redhat.com/en/documentation/openshift_container_platform/4.22/html/installing_an_on-premise_cluster_with_the_agent-based_installer/
apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: ""
rendezvousIP: ""
additionalNTPSources: []
hosts: []
